generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantPlan {
  FREE
  PRO
}

enum TenantRole {
  OWNER
  ADMIN
}

enum GalleryTheme {
  NOCTURNE
  PAPER
  MOSS
}

model Tenant {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  status               TenantStatus       @default(ACTIVE)
  plan                 TenantPlan         @default(FREE)
  theme                GalleryTheme       @default(NOCTURNE)
  publicShareId        String?            @unique
  botCredential        TenantBotCredential?
  storageUsedBytes     BigInt             @default(0)
  storageReservedBytes BigInt             @default(0)
  albumCount           Int                @default(0)
  photoCount           Int                @default(0)
  memberships          TenantMembership[]
  albums               Album[]
  reports              Report[]
  operatorAudits       OperatorAudit[]
  billingCheckouts     BillingCheckout[]
  subscription         Subscription?
  billingPayments      BillingPayment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model TenantBotCredential {
  tenantId            String   @id
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramBotId       BigInt   @unique
  username            String
  adminAppShortName   String
  galleryAppShortName String
  tokenCiphertext     Bytes
  tokenIv             Bytes
  tokenAuthTag        Bytes
  keyId               String
  verifiedAt          DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([username])
}

model TenantMembership {
  tenantId  String
  tgUserId  BigInt
  role      TenantRole @default(OWNER)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([tenantId, tgUserId])
  @@index([tgUserId])
}

model Album {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photos        Photo[]
  uploadIntents UploadIntent[]
  reports       Report[]
  createdAt     DateTime       @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model Photo {
  id           String        @id @default(cuid())
  key          String        @unique // opaque original object key
  thumbKey     String? // opaque lightweight grid preview key (webp), null for legacy rows
  previewKey   String? // opaque medium-res album cover preview key (webp)
  mimeType     String
  size         Int
  storedBytes  BigInt        @default(0)
  width        Int?
  height       Int?
  position     Int           @default(0) // manual sort order within the album (asc)
  tenantId     String
  album        Album         @relation(fields: [albumId, tenantId], references: [id, tenantId], onDelete: Cascade)
  albumId      String
  uploadIntent UploadIntent?
  reports      Report[]
  createdAt    DateTime      @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, albumId, position])
}

enum UploadIntentStatus {
  PENDING
  UPLOADED
  CONFIRMED
  EXPIRED
  FAILED
}

model UploadIntent {
  id               String             @id @default(cuid())
  key              String             @unique
  tenantId         String
  album            Album              @relation(fields: [albumId, tenantId], references: [id, tenantId], onDelete: Cascade)
  albumId          String
  expectedMimeType String
  expectedSize     Int
  reservedBytes    BigInt             @default(0)
  reservationReleasedAt DateTime?
  status           UploadIntentStatus @default(PENDING)
  expiresAt        DateTime
  photo            Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  photoId          String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, albumId])
}

enum ReportReason {
  SPAM
  ILLEGAL_CONTENT
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reporterTgUserId BigInt?
  reporterFingerprint String?
  albumId          String?
  album             Album?       @relation(fields: [albumId, tenantId], references: [id, tenantId], onDelete: Cascade)
  photoId          String?
  photo             Photo?       @relation(fields: [photoId, tenantId], references: [id, tenantId], onDelete: Cascade)
  reason           ReportReason
  detail           String?
  status           ReportStatus @default(OPEN)
  staffNote        String?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  operatorAudits   OperatorAudit[]

  @@index([tenantId, status, createdAt])
  @@index([reporterTgUserId, createdAt])
  @@index([reporterFingerprint, createdAt])
}

enum OperatorAuditAction {
  TENANT_SUSPENDED
  TENANT_UNSUSPENDED
  REPORT_RESOLVED
  REPORT_DISMISSED
  PAYMENT_REFUNDED
}

model OperatorAudit {
  id        String              @id @default(cuid())
  actor     String
  action    OperatorAuditAction
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reportId  String?
  report    Report?             @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reason    String
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@index([reportId, createdAt])
}

enum BillingCheckoutStatus {
  PENDING
  PRECHECKOUT_APPROVED
  PAID
  EXPIRED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
}

enum BillingRefundStatus {
  NONE
  PENDING
  REFUNDED
  FAILED
}

enum TelegramUpdateStatus {
  PROCESSING
  PROCESSED
  REJECTED
  RETRYABLE
}

model BillingCheckout {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payerTgUserId         BigInt
  plan                  TenantPlan
  expectedStars         Int
  status                BillingCheckoutStatus @default(PENDING)
  expiresAt             DateTime
  preCheckoutQueryId    String?               @unique
  preCheckoutApprovedAt DateTime?
  paidAt                DateTime?
  payments              BillingPayment[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([payerTgUserId, createdAt])
}

model Subscription {
  id                      String             @id @default(cuid())
  tenantId                String             @unique
  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payerTgUserId           BigInt
  plan                    TenantPlan
  status                  SubscriptionStatus @default(ACTIVE)
  telegramPaymentChargeId String?            @unique
  currentPeriodEnd        DateTime
  graceEndsAt             DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  lastPaymentAt           DateTime
  payments                BillingPayment[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
  @@index([payerTgUserId])
}

model BillingPayment {
  id                      String              @id @default(cuid())
  telegramPaymentChargeId String              @unique
  tenantId                String
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  checkoutId              String
  checkout                BillingCheckout     @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  subscriptionId          String
  subscription            Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  telegramUpdateId        String?             @unique
  telegramUpdate          TelegramUpdate?     @relation(fields: [telegramUpdateId], references: [id], onDelete: SetNull)
  payerTgUserId           BigInt
  plan                    TenantPlan
  amountStars             Int
  currency                String
  isRecurring             Boolean
  isFirstRecurring        Boolean
  paidAt                  DateTime
  periodEnd               DateTime
  refundStatus            BillingRefundStatus @default(NONE)
  refundReason            String?
  refundErrorSummary      String?
  refundedAt              DateTime?
  createdAt               DateTime            @default(now())

  @@index([tenantId, paidAt])
  @@index([checkoutId])
  @@index([subscriptionId, periodEnd])
}

model TelegramUpdate {
  id           String               @id @default(cuid())
  updateId     BigInt?              @unique
  type         String
  status       TelegramUpdateStatus @default(PROCESSING)
  attempts     Int                  @default(1)
  errorSummary String?
  processedAt  DateTime?
  payment      BillingPayment?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, updatedAt])
}
