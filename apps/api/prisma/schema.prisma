generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Album {
  id        String   @id @default(cuid())
  name      String
  photos    Photo[]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  key       String   @unique // R2 object key
  thumbKey  String? // R2 key of the lightweight preview (webp), null for legacy rows
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  position  Int      @default(0) // manual sort order within the album (asc)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId   String
  createdAt DateTime @default(now())

  @@index([albumId, position])
}
