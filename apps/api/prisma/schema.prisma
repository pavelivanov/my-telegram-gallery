generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantPlan {
  FREE
}

enum TenantRole {
  OWNER
}

model Tenant {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  status      TenantStatus       @default(ACTIVE)
  plan        TenantPlan         @default(FREE)
  memberships TenantMembership[]
  albums      Album[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TenantMembership {
  tenantId  String
  tgUserId  BigInt
  role      TenantRole @default(OWNER)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([tenantId, tgUserId])
  @@index([tgUserId])
}

model Album {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photos        Photo[]
  uploadIntents UploadIntent[]
  createdAt     DateTime       @default(now())

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
}

model Photo {
  id           String        @id @default(cuid())
  key          String        @unique // opaque original object key
  thumbKey     String? // opaque lightweight grid preview key (webp), null for legacy rows
  previewKey   String? // opaque medium-res album cover preview key (webp)
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  position     Int           @default(0) // manual sort order within the album (asc)
  tenantId     String
  album        Album         @relation(fields: [albumId, tenantId], references: [id, tenantId], onDelete: Cascade)
  albumId      String
  uploadIntent UploadIntent?
  createdAt    DateTime      @default(now())

  @@index([tenantId, albumId, position])
}

enum UploadIntentStatus {
  PENDING
  UPLOADED
  CONFIRMED
  EXPIRED
  FAILED
}

model UploadIntent {
  id               String             @id @default(cuid())
  key              String             @unique
  tenantId         String
  album            Album              @relation(fields: [albumId, tenantId], references: [id, tenantId], onDelete: Cascade)
  albumId          String
  expectedMimeType String
  expectedSize     Int
  status           UploadIntentStatus @default(PENDING)
  expiresAt        DateTime
  photo            Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  photoId          String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, albumId])
}
