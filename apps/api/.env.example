# Postgres (Railway provides DATABASE_URL automatically when you add a Postgres service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gallery?schema=public"

# Telegram bot token from @BotFather — used to validate Mini App init data
TELEGRAM_BOT_TOKEN=""

# Telegram user id of the admin (the only account allowed to upload/delete).
# Get yours from @userinfobot.
ADMIN_TG_ID=""

# Cloudflare R2 (S3-compatible). Create an API token in the R2 dashboard.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gallery"

# Comma-separated CORS origins of the admin + gallery TMAs
# (e.g. https://admin.up.railway.app,https://gallery.up.railway.app)
WEB_ORIGINS=""
