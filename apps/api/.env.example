# Postgres (Railway provides DATABASE_URL automatically when you add a Postgres service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gallery?schema=public"

# Telegram bot token from @BotFather — used to validate Mini App init data
TELEGRAM_BOT_TOKEN=""

# Public BotFather identity used to construct canonical Mini App links.
TELEGRAM_BOT_USERNAME="your_gallery_bot"
TELEGRAM_ADMIN_APP_SHORT_NAME="admin"
TELEGRAM_GALLERY_APP_SHORT_NAME="gallery"

# Comma-separated Telegram user ids allowed to administer this single gallery.
# Get ids from @userinfobot. Legacy ADMIN_TG_ID remains accepted.
ADMIN_TG_IDS=""

# single (default): ADMIN_TG_IDS owns tenant_default.
# multi: owners are checked through database memberships.
TENANCY_MODE="single"

# Reject Telegram Mini App init data older than this many seconds (60–86400).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="3600"

# Storage and transfer are independent. Filesystem + proxy is the self-hosted
# default; s3 supports proxy or direct browser transfers.
STORAGE_DRIVER="filesystem"
STORAGE_TRANSFER_MODE="proxy"
FILESYSTEM_STORAGE_PATH="/var/lib/my-telegram-gallery/media"

# Standard S3 settings (required only for STORAGE_DRIVER=s3).
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="gallery"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Deprecated Cloudflare R2 aliases remain accepted when standard S3 settings
# are absent: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET.

# Upload intents and server-side image validation.
UPLOAD_MAX_BYTES="26214400"
UPLOAD_INTENT_TTL_SECONDS="600"

# At least 32 random bytes. Signs short-lived proxy image URLs; this is not the
# Telegram bot token and should be generated independently.
MEDIA_URL_SIGNING_SECRET=""
MEDIA_URL_TTL_SECONDS="3600"

# Maximum time readiness waits for database and storage checks.
READINESS_TIMEOUT_MS="3000"

# Optional comma-separated CORS origins of the admin + gallery TMAs.
# Empty means no cross-origin access; requests from the same origin still work.
# (e.g. https://admin.up.railway.app,https://gallery.up.railway.app)
WEB_ORIGINS=""

# Optional directory containing gallery/ and admin/ Vite builds. Leave empty
# when the API is run separately during local frontend development.
STATIC_ROOT=""
