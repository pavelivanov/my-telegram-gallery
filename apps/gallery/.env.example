# Base URL of the NestJS API (no trailing slash)
VITE_API_BASE_URL="http://localhost:3000"

# Telegram Mini App link of this gallery app (BotFather direct link, no trailing slash),
# e.g. https://t.me/your_bot/gallery — used to build album share links.
VITE_GALLERY_TMA_LINK=""

# Development only: fresh signed init data for running outside Telegram.
# Never put TELEGRAM_BOT_TOKEN in a VITE_* variable.
VITE_MOCK_INIT_DATA=""
