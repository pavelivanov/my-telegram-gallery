# Public hostname with DNS A/AAAA records pointing at this server.
DOMAIN=gallery.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Source/version metadata embedded into locally built images. The initializer
# replaces these with the exact current Git revision when run from a clean
# checkout. BUILD_SOURCE_URL must be reachable by every network user.
BUILD_SOURCE=https://github.com/pavelivanov/my-telegram-gallery
BUILD_SOURCE_URL=https://github.com/pavelivanov/my-telegram-gallery/tree/main
BUILD_REVISION=main
BUILD_VERSION=0.0.0-self-host

# PostgreSQL runs only inside the Compose network.
POSTGRES_USER=gallery
POSTGRES_DB=gallery
POSTGRES_PASSWORD=

# Required BotFather and administrator identity.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_gallery_bot
TELEGRAM_ADMIN_APP_SHORT_NAME=admin
TELEGRAM_GALLERY_APP_SHORT_NAME=gallery
ADMIN_TG_IDS=
TENANCY_MODE=single
# Multi-mode SaaS admission. Keep open for normal onboarding; use allowlist plus
# numeric IDs for private beta, or closed to stop all new gallery creation.
TENANT_CREATION_MODE=open
TENANT_CREATION_TG_IDS=
TENANT_BOT_ENCRYPTION_KEYS=

# Optional Telegram Stars billing. It stays disabled while these are blank.
# Keep test mode true until the complete test-environment checklist passes.
TELEGRAM_BOT_API_TEST_MODE=true
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BODY_LIMIT_BYTES=65536
TELEGRAM_BOT_API_TIMEOUT_MS=5000
BILLING_PRO_PRICE_STARS=
BILLING_CHECKOUT_TTL_SECONDS=900
PAY_SUPPORT_CONTACT=
BILLING_TERMS_URL=
BILLING_PRIVACY_URL=

# Filesystem + proxy is the default self-hosted storage mode.
STORAGE_DRIVER=filesystem
STORAGE_TRANSFER_MODE=proxy
MEDIA_URL_SIGNING_SECRET=
UPLOAD_MAX_BYTES=26214400
RUN_MIGRATIONS_ON_START=true

# Request hardening for the supplied one-Caddy/one-app topology.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT_BYTES=131072
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_ADMIN=60
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_REPORT=5
RATE_LIMIT_WEBHOOK=120

# Optional operator CLI identity. Store only the SHA-256 digest here; provide
# the raw OPS_TOKEN to an individual operator process, never to a frontend.
OPS_TOKEN_SHA256=
OPS_ACTOR=

# Optional server-side Sentry monitoring. Leave the DSN empty to disable it.
# Keep tracing at zero unless its privacy and volume impact has been reviewed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional S3-compatible storage. Set STORAGE_DRIVER=s3 and fill these values.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Same-origin deployments do not need CORS. Add comma-separated origins only
# when intentionally running a legacy split frontend.
WEB_ORIGINS=
