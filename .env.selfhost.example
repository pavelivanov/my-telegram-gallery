# Public hostname with DNS A/AAAA records pointing at this server.
DOMAIN=gallery.example.com
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL runs only inside the Compose network.
POSTGRES_USER=gallery
POSTGRES_DB=gallery
POSTGRES_PASSWORD=

# Required BotFather and administrator identity.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_gallery_bot
TELEGRAM_ADMIN_APP_SHORT_NAME=admin
TELEGRAM_GALLERY_APP_SHORT_NAME=gallery
ADMIN_TG_IDS=
TENANCY_MODE=single

# Filesystem + proxy is the default self-hosted storage mode.
STORAGE_DRIVER=filesystem
STORAGE_TRANSFER_MODE=proxy
MEDIA_URL_SIGNING_SECRET=
UPLOAD_MAX_BYTES=26214400
RUN_MIGRATIONS_ON_START=true

# Request hardening for the supplied one-Caddy/one-app topology.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT_BYTES=131072
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_ADMIN=60
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_REPORT=5

# Optional operator CLI identity. Store only the SHA-256 digest here; provide
# the raw OPS_TOKEN to an individual operator process, never to a frontend.
OPS_TOKEN_SHA256=
OPS_ACTOR=

# Optional S3-compatible storage. Set STORAGE_DRIVER=s3 and fill these values.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Same-origin deployments do not need CORS. Add comma-separated origins only
# when intentionally running a legacy split frontend.
WEB_ORIGINS=
