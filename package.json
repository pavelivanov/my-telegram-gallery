{
  "name": "my-telegram-gallery",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:gallery": "pnpm --filter gallery dev",
    "dev:api": "pnpm --filter api start:dev",
    "build:admin": "pnpm --filter admin build",
    "build:gallery": "pnpm --filter gallery build",
    "build:api": "pnpm --filter api build",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "@tma.js/sdk": "3.0.8",
      "@tma.js/bridge": "2.1.3",
      "@tma.js/signals": "1.0.1"
    }
  }
}
